#!/bin/bash
# /usr/local/sbin/panel-vhost — Gestión de vhosts nginx para el portal de clientes
# Uso: panel-vhost add <fqdn> <nodeIP> <port>
#      panel-vhost add-app <nombre> <nodeIP> <port>    (usa wildcard cert)
#      panel-vhost update-cert <fqdn>                   (actualiza SSL path tras emitir cert)
#      panel-vhost issue-cert <fqdn>                    (emite cert Let's Encrypt HTTP-01)
#      panel-vhost remove <fqdn>
# Solo ejecutable por root o via sudo (entry en sudoers).

set -euo pipefail

NGINX_AVAIL="/etc/nginx/sites-available"
NGINX_ENABLED="/etc/nginx/sites-enabled"
WILDCARD_CERT="/etc/nginx/ssl/wildcard-capuvps"
ACME_WEBROOT="/var/www/acme"

# Leer dominio de apps desde env o archivo de config del panel
APPS_DOMAIN="${APPS_DOMAIN:-}"
if [ -f /opt/vps-panel/backend/.env ]; then
  APPS_DOMAIN=$(grep '^APPS_DOMAIN=' /opt/vps-panel/backend/.env | cut -d= -f2-)
fi

# Dominios que NUNCA se pueden tocar
PROTECTED="capuvps.duckdns.org pachucacv.duckdns.org"

die() { echo "ERROR: $*" >&2; exit 1; }

validate_domain() {
  local d="$1"
  echo "$d" | grep -qE '^[a-z0-9][a-z0-9._-]{1,60}[a-z0-9]$' || die "Dominio inválido: $d"
  for p in $PROTECTED; do
    # OJO: usar if, no "[ ] && die" — con set -e el test falso al final de la
    # función devolvía 1 y mataba el script en silencio.
    if [ "$d" = "$p" ]; then die "Dominio protegido, no se puede modificar: $d"; fi
  done
  return 0
}

write_vhost() {
  local fqdn="$1" node_ip="$2" port="$3" cert_base="$4"
  cat > "${NGINX_AVAIL}/${fqdn}" <<NGINX
server {
    listen 443 ssl http2;
    server_name ${fqdn};

    ssl_certificate     ${cert_base}/fullchain.pem;
    ssl_certificate_key ${cert_base}/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    location /.well-known/acme-challenge/ {
        root ${ACME_WEBROOT};
    }

    location / {
        proxy_pass         http://${node_ip}:${port};
        proxy_set_header   Host \$host;
        proxy_set_header   X-Real-IP \$remote_addr;
        proxy_set_header   X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
NGINX
}

case "${1:-}" in

add)
  # Dominio personalizado (cert propio)
  FQDN="${2:-}"; NODE_IP="${3:-}"; PORT="${4:-}"
  [ -z "$FQDN" ] || [ -z "$NODE_IP" ] || [ -z "$PORT" ] && die "Uso: panel-vhost add <fqdn> <nodeIP> <port>"
  validate_domain "$FQDN"
  CERT_BASE="/etc/nginx/ssl/${FQDN}"
  # Si el cert aún no existe, usar un self-signed temporal para que nginx cargue el vhost
  if [ ! -f "${CERT_BASE}/fullchain.pem" ]; then
    mkdir -p "$CERT_BASE"
    openssl req -x509 -newkey rsa:2048 -keyout "${CERT_BASE}/key.pem" -out "${CERT_BASE}/fullchain.pem" \
      -days 1 -nodes -subj "/CN=${FQDN}" 2>/dev/null
  fi
  write_vhost "$FQDN" "$NODE_IP" "$PORT" "$CERT_BASE"
  # Bloque port 80: ACME challenge + redirect HTTPS (permite issue-cert via HTTP-01)
  cat >> "${NGINX_AVAIL}/${FQDN}" <<NGINX80

server {
    listen 80;
    server_name ${FQDN};
    location /.well-known/acme-challenge/ {
        root ${ACME_WEBROOT};
    }
    location / {
        return 301 https://\$host\$request_uri;
    }
}
NGINX80
  ln -sf "${NGINX_AVAIL}/${FQDN}" "${NGINX_ENABLED}/${FQDN}"
  nginx -t 2>&1 && systemctl reload nginx && echo "VHOST-OK: $FQDN"
  ;;

add-app)
  # Subdominio de plataforma — usa cert wildcard compartido
  NOMBRE="${2:-}"; NODE_IP="${3:-}"; PORT="${4:-}"
  [ -z "$NOMBRE" ] || [ -z "$NODE_IP" ] || [ -z "$PORT" ] && die "Uso: panel-vhost add-app <nombre> <nodeIP> <port>"
  [ -z "$APPS_DOMAIN" ] && die "APPS_DOMAIN no configurado"
  echo "$NOMBRE" | grep -qE '^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$' || die "Nombre inválido: $NOMBRE"
  FQDN="${NOMBRE}.${APPS_DOMAIN}"
  validate_domain "$FQDN"
  [ -f "${WILDCARD_CERT}/fullchain.pem" ] || die "Cert wildcard no encontrado en ${WILDCARD_CERT}. Ejecuta primero: acme.sh --issue --dns dns_duckdns -d ${APPS_DOMAIN} -d '*.${APPS_DOMAIN}'"
  write_vhost "$FQDN" "$NODE_IP" "$PORT" "$WILDCARD_CERT"
  ln -sf "${NGINX_AVAIL}/${FQDN}" "${NGINX_ENABLED}/${FQDN}"
  nginx -t 2>&1 && systemctl reload nginx && echo "VHOST-OK: $FQDN"
  ;;

update-cert)
  # Actualizar vhost para que use el cert definitivo (tras emitir con acme.sh)
  FQDN="${2:-}"
  [ -z "$FQDN" ] && die "Uso: panel-vhost update-cert <fqdn>"
  validate_domain "$FQDN"
  CERT_BASE="/etc/nginx/ssl/${FQDN}"
  [ -f "${CERT_BASE}/fullchain.pem" ] || die "Cert no encontrado en ${CERT_BASE}"
  # El vhost ya tiene la ruta correcta; solo recargar nginx
  nginx -t 2>&1 && systemctl reload nginx && echo "CERT-UPDATED: $FQDN"
  ;;

issue-cert)
  # Emitir cert Let's Encrypt via HTTP-01 webroot (requiere DNS → esta IP)
  FQDN="${2:-}"
  [ -z "$FQDN" ] && die "Uso: panel-vhost issue-cert <fqdn>"
  validate_domain "$FQDN"
  CERT_BASE="/etc/nginx/ssl/${FQDN}"
  mkdir -p "$ACME_WEBROOT" "$CERT_BASE"
  /root/.acme.sh/acme.sh --issue -w "$ACME_WEBROOT" -d "$FQDN" --server letsencrypt --force 2>&1 | tail -10 || die "acme.sh falló — verifica que el DNS apunte a este servidor"
  /root/.acme.sh/acme.sh --install-cert -d "$FQDN" \
    --fullchain-file "${CERT_BASE}/fullchain.pem" \
    --key-file "${CERT_BASE}/key.pem" \
    --reloadcmd "systemctl reload nginx" 2>&1 | tail -5
  nginx -t 2>&1 && systemctl reload nginx && echo "CERT-ISSUED: $FQDN"
  ;;

remove)
  FQDN="${2:-}"
  [ -z "$FQDN" ] && die "Uso: panel-vhost remove <fqdn>"
  validate_domain "$FQDN"
  rm -f "${NGINX_ENABLED}/${FQDN}" "${NGINX_AVAIL}/${FQDN}"
  nginx -t 2>&1 && systemctl reload nginx && echo "VHOST-REMOVED: $FQDN"
  ;;

*)
  echo "Uso: panel-vhost {add|add-app|update-cert|remove} ..." >&2
  exit 1
  ;;
esac
