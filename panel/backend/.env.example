# Copia a .env y rellena. NUNCA subas .env a git.

# Puerto local del backend (nginx hace proxy hacia aquí)
PORT=3001
HOST=127.0.0.1

# Contraseña de acceso al panel (login de los desarrolladores)
PANEL_PASSWORD=CambiaEstaClave!

# Secreto para firmar los JWT de sesión (genera uno: openssl rand -hex 32)
JWT_SECRET=

# Clave para cifrar las credenciales de los VPS en disco (openssl rand -hex 32)
CRED_SECRET=

# Horas de validez de la sesión
SESSION_HOURS=12
