---
import InstagramIcon from '@/icons/instagram.svg'

interface Props {
  lang?: 'es' | 'en'
}

const { lang = 'en' } = Astro.props

const translations = {
  en: {
    title: 'Academy Updates',
    instagramHandle: '@pachucavalle',
  },
  es: {
    title: 'Actualizaciones de la Academia',
    instagramHandle: '@pachucavalle',
  },
}

const t = translations[lang]
---

<section id='updates' class='items-center py-12'>
  <div class='flex mb-5'>
    <h3
      class='text-3xl md:text-6xl text-amber-500 mx-auto font-special font-bold uppercase'
    >
      {t.title}
    </h3>
  </div>
  <div class='flex items-center justify-center'>
    <a
      href='https://www.instagram.com/pachucavalle/p/DJILp07hpBf/'
      rel='noopener noreferrer'
      target='_blank'
      class='aspect-square w-64 relative hover:scale-105 transition group'
    >
      <img
        src='/posts/1.webp'
        alt='Post 1'
        class='w-full h-full object-cover'
      />
      <div
        class='absolute inset-0 w-full h-full flex flex-col justify-end bg-black/40 transition opacity-0 group-hover:opacity-100'
      >
        <div class='flex items-center gap-2 p-2'>
          <InstagramIcon />
          <span>{t.instagramHandle}</span>
        </div>
      </div>
      <div
        class='absolute top-2 right-2 p-2 inline-flex aspect-square items-center justify-center bg-black/50 rounded-full'
      >
        <InstagramIcon />
      </div>
    </a>
  </div>
</section>
