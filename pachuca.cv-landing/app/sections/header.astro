---
import { Image } from 'astro:assets'

interface Props {
  lang?: 'es' | 'en'
}

const { lang = 'en' } = Astro.props

const translations = {
  en: {
    home: 'Home',
    whyUs: 'Why Us',
    aboutUs: 'About Us',
    updates: 'Updates',
    applyNow: 'Apply Now',
  },
  es: {
    home: 'Inicio',
    whyUs: 'Por qué nosotros',
    aboutUs: 'Sobre nosotros',
    updates: 'Actualizaciones',
    applyNow: 'Aplica ahora',
  },
}

const t = translations[lang]
---

<header
  transition:name='header'
  class='fixed left-0 right-0 p-4 z-50 backdrop-blur-xs'
>
  <div class='flex items-center justify-between container mx-auto'>
    <a href='/#top' class='w-12'>
      <Image
        src='/images/logo.webp'
        alt='Logo of pachuca central valley'
        width={512}
        height={646}
      />
    </a>
    <nav class='hidden md:flex items-center gap-10'>
      <a
        href={lang == 'en' ? '/#top' : '/es#top'}
        class='transition hover:scale-95 hover:text-gray-200'
      >
        <span>{t.home}</span>
      </a>
      <a
        href={lang == 'en' ? '/#why' : '/es#why'}
        class='transition hover:scale-95 hover:text-gray-200'
      >
        <span>{t.whyUs}</span>
      </a>
      <a href={lang == 'en' ? '/#about' : '/es#about'} class='transition hover:scale-95 hover:text-gray-200'>
        <span>{t.aboutUs}</span>
      </a>
      <a  href={lang == 'en' ? '/#updates' : '/es#updates'} class='transition hover:scale-95 hover:text-gray-200'>
        <span>{t.updates}</span>
      </a>
    </nav>
    <div>
      <a
        href={lang == 'en' ? '/apply' : '/aplicar'}
        class='inline-flex items-center gap-2 bg-pcv-yellow px-4 py-3 rounded-md text-black font-medium duration-300 transition hover:-translate-y-0.5 hover:opacity-90'
        >{t.applyNow}
      </a>
    </div>
  </div>
</header>
