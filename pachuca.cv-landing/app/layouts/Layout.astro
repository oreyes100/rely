---
import '@/styles/globals.css'
import { ClientRouter } from 'astro:transitions'

interface Props {
  lang?: 'es' | 'en'
  title?: string
  description?: string
  metadata?: {
    name: string
    content: string
  }[]
}

const { lang = 'en', title, description, metadata } = Astro.props
---

<html lang={lang}>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width,initial-scale=1' />
    <title>{title}</title>
    <meta name='description' content={description} />

    <link rel='icon' href='/favicon.ico' sizes='any' />

    <link rel='sitemap' href='/sitemap-index.xml' />

    {metadata.map((m) => <meta name={m.name} content={m.content} />)}

    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
