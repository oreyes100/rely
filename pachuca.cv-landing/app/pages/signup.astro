---
import ContextProvider from '@/sections/contextProvider'
import Layout from '@/layouts/Layout.astro'
---

<Layout>
  <main class='flex flex-col gap-8 items-center justify-center min-h-dvh p-4'>
    <div class='fixed inset-0 overflow-hidden opacity-10 pointer-events-none'>
      <div
        class='absolute top-1/2 left-0 right-0 h-px bg-white/50 transform -translate-y-1/2'
      >
      </div>
      <div
        class='absolute top-0 bottom-0 left-1/2 w-px bg-white/50 transform -translate-x-1/2'
      >
      </div>
      <div
        class='absolute top-1/2 left-1/2 w-[200px] h-[200px] border-2 border-white/50 rounded-full transform -translate-x-1/2 -translate-y-1/2'
      >
      </div>
      <div
        class='absolute top-0 left-1/2 size-24 border-2 border-white/50 transform -translate-y-1/2 -translate-x-1/2 rounded-b-full'
      >
      </div>
      <div
        class='absolute bottom-0 left-1/2 size-24 border-2 border-white/50 transform translate-y-1/2 -translate-x-1/2 rounded-t-full'
      >
      </div>
    </div>
    <ContextProvider client:only/>
  </main>
</Layout>
