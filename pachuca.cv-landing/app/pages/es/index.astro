  metadata={[
    {
      name: 'keywords',
      content:
        'Pachuca Valle Central, Academia de Fútbol, Entrenamiento de Fútbol, Fútbol Juvenil, Fútbol de Élite, Desarrollo de Fútbol, Valle Central Fútbol',
    },
    {
      name: 'og:title',
      content: 'Academia de Fútbol Pachuca Valle Central - Enciende tu Pasión',
    },
    {
      name: 'og:description',
      content:
        'Entrenamiento de élite, entrenadores expertos y un camino hacia la excelencia. Descubre tu potencial con una academia de fútbol líder.',
    },
    {
      name: 'og:type',
      content: 'website',
    },
    {
      name: 'og:url',
      content: 'https://www.pachuca.vc/',
    },
    {
      name: 'og:image',
      content: 'https://www.pachuca.vc/images/og-es.jpg',
    },
    {
      name: 'og:image:width',
      content: '1200',
    },
    {
      name: 'og:image:height',
