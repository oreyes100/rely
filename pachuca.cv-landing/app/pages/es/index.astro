      name: 'twitter:title',
      content: 'Academia de Fútbol Pachuca Valle Central - Enciende tu Pasión',
    },
    {
      name: 'twitter:description',
      content:
        'Entrenamiento de élite, entrenadores expertos y un camino hacia la excelencia. Descubre tu potencial.',
    },
    {
      name: 'twitter:image',
      content: 'https://www.pachuca.vc/images/og-es.jpg',
    },
    {
      name: 'theme-color',
      content: '#1F232F',
    },
  ]}
/>
  <Header lang='es' />
  <main>
    <Hero lang='es' />
    <Speach lang='es' />
    <About lang='es' />
    <Social lang='es' />
